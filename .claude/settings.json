{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/jst-date.sh\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Bash(date:*)",
      "Bash(TZ=Asia/Tokyo date:*)",
      "mcp__Notion",
      "mcp__Slack"
    ]
  }
}
